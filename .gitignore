# Root level gitignore for IHH_CRM monorepo

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*
.vs/

# Environment files (use .env.example instead)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
dist/
build/

# Dependencies
node_modules/
vendor/
